# CWS Backend — biến môi trường bắt buộc
# Copy file này thành .env và điền giá trị thật trước khi chạy.
# TUYỆT ĐỐI không commit file .env (đã có trong .gitignore).

PORT=3000

# Supabase — dùng SERVICE ROLE KEY (không phải publishable/anon key mà
# Worker đang dùng) vì Backend là server tin cậy, cần toàn quyền đọc/ghi
# các bảng mới (render_orders, payments, sites, machine_capability).
# Lấy tại: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backblaze B2 — dùng Application Key riêng cho Backend (khác Worker),
# nên giới hạn quyền chỉ đọc/ghi đúng bucket cần dùng.
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Google Drive API Key (TÙY CHỌN) — nếu để trống, Backend vẫn hoạt
# động nhưng KHÔNG lấy được tên file/dung lượng thật từ Drive link
# (trả về null, không bịa dữ liệu giả). Lấy tại: console.cloud.google.com
# > APIs & Services > Credentials > Create API Key > bật Google Drive API.
GOOGLE_DRIVE_API_KEY=

# CORS — domain Portal thật (vd https://cws-portal.vercel.app).
# Để * khi test local, ĐỔI thành domain thật khi deploy production.
CORS_ORIGIN=*

# Google Login: KHÔNG cấu hình ở Backend nữa — dùng Supabase Auth.
# Bật tại Supabase Dashboard > Authentication > Providers > Google,
# điền Client ID/Secret thật từ console.cloud.google.com ở ĐÓ (không
# phải ở file này). KHÔNG BAO GIỜ commit Client Secret vào repo. Backend
# chỉ xác thực Bearer token qua
# SupabaseService.getClient().auth.getUser() — xem
# common/optional-auth.util.ts, không cần biến môi trường riêng nào.

# MB Bank (TÙY CHỌN) — số tài khoản/tên chủ tài khoản THẬT để nhận
# thanh toán. Nếu để trống, Portal chỉ hiển thị nội dung chuyển khoản
# dạng text (không bịa ảnh QR trỏ tới tài khoản không có thật). Khi
# điền, QrBankProvider tự dựng ảnh VietQR quét được qua img.vietqr.io
# (dịch vụ công khai, không cần đăng ký/API key riêng).
MB_BANK_ACCOUNT_NUMBER=
MB_BANK_ACCOUNT_NAME=

# Admin API Key — shared secret đơn giản (KHÔNG phải hệ thống phân
# quyền enterprise) bảo vệ các route Giai đoạn 7 (GET /jobs khi không
# đăng nhập, /jobs/by-storage-code, /payments/by-code). Bắt buộc phải
# điền — nếu để trống, các route này TỪ CHỐI mọi request (fail-closed).
# Tạo 1 chuỗi ngẫu nhiên dài, vd: openssl rand -hex 32. Gọi API kèm
# header: x-admin-key: <giá trị này>.
ADMIN_API_KEY=

# Payment Webhook Secret — shared secret bảo vệ POST /payments/webhook.
# Nội dung webhook (payment_code/storage_code/amount) KHÔNG phải bí mật
# vì chính khách hàng nhìn thấy các giá trị này trên QR để chuyển khoản
# — nếu không có secret này, bất kỳ ai biết payment của mình đều có thể
# tự gọi thẳng webhook để đánh dấu PAID mà không cần chuyển tiền thật.
# Bắt buộc phải điền — nếu để trống, webhook TỪ CHỐI mọi request
# (fail-closed). Tạo 1 chuỗi ngẫu nhiên dài, vd: openssl rand -hex 32,
# rồi khai báo đúng chuỗi đó khi cấu hình URL webhook ở phía ngân hàng/
# cổng trung gian tự viết — gọi kèm header: x-webhook-secret: <giá trị
# này>. Route này KHÔNG dùng cho SePay (xem SEPAY_WEBHOOK_API_KEY bên
# dưới, route riêng /payments/webhook/sepay) — chỉ giữ lại cho gateway
# tự viết/tuỳ chỉnh được header.
PAYMENT_WEBHOOK_SECRET=

# SePay (POST /payments/webhook/sepay) — gateway trung gian THẬT tự động
# phát hiện tiền vào MB Bank, đã research 2026-08-01 (xem
# backend/BACKEND_SETUP.md mục 3c): free tier 0đ/tháng, 50 giao dịch/
# tháng, có MB Bank + webhook/API ngay từ free (Casso free KHÔNG có
# custom webhook, chỉ Starter 99k/tháng trở lên — không hợp MVP miễn
# phí). Tạo tài khoản tại sepay.vn, liên kết MB Bank thật, vào Webhooks
# > Add webhook > Security > API Key, tự sinh 1 key ngẫu nhiên (vd
# openssl rand -hex 32) rồi điền CÙNG giá trị đó ở đây — SePay gửi kèm
# header cố định "Authorization: Apikey <giá trị này>" (không tuỳ biến
# được tên header, chỉ giá trị key). Bắt buộc phải điền — nếu để trống,
# route /payments/webhook/sepay TỪ CHỐI mọi request (fail-closed).
SEPAY_WEBHOOK_API_KEY=

# POST /payment/notification (app Android MBBank Notification Listener):
# KHÔNG có biến môi trường riêng — mỗi thiết bị có secret RIÊNG lưu trong
# bảng payment_devices (migration 015_payment_devices.sql), đăng ký thủ
# công qua Supabase SQL Editor sau khi cài app Android (xem
# android-payment-listener/README.md + common/guards/device-signature.guard.ts).
