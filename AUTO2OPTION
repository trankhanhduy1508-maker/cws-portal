$wshell = New-Object -ComObject WScript.Shell

# === CAU HINH ===
$SEND_INTERVAL = 3

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "  AUTO CODEX - KHONG DUNG AppActivate" -ForegroundColor Cyan
Write-Host "  HAY CLICK CHUOT VAO CUA SO CODEX TRUOC!" -ForegroundColor Yellow
Write-Host "  Sau do dung tay - dung cham vao may" -ForegroundColor Yellow
Write-Host "  Chay VO HAN - Nhan Ctrl+C de dung" -ForegroundColor Red
Write-Host "========================================" -ForegroundColor Cyan

$startTime = Get-Date

Write-Host "`nBat dau: $(Get-Date -Format 'HH:mm:ss')" -ForegroundColor Green
Write-Host "Chay VO HAN - Nhan Ctrl+C de dung" -ForegroundColor Red

try {
    while ($true) {
        
        $elapsed = (New-TimeSpan -Start $startTime).ToString('hh\:mm\:ss')
        
        if ((Get-Date).Second -eq 0) {
            Write-Host "`r[$elapsed] Dang chay...    " -NoNewline -ForegroundColor DarkGray
        }
        
        # KHONG goi AppActivate - chi gui phim thoi
        Start-Sleep -Milliseconds 200
        
        # Nhan DOWN de chon option 2
        $wshell.SendKeys("{DOWN}")
        Start-Sleep -Milliseconds 300
        
        # Nhan Enter
        $wshell.SendKeys("{ENTER}")
        
        Start-Sleep -Seconds $SEND_INTERVAL
    }
    
} catch {
    Write-Host "`n`n[!] Bi dung: $_" -ForegroundColor Red
    
} finally {
    if ($wshell -ne $null) {
        [System.Runtime.Interopservices.Marshal]::ReleaseComObject($wshell) | Out-Null
    }
    Write-Host "[*] Da dung. Ngu ngon!" -ForegroundColor Cyan
}
