# Staging-only Node Agent / Generic Worker contract.
# Do not copy production values here. Inject real values through Windows
# environment/secret storage; never commit them.
CWS_STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
CWS_STAGING_SUPABASE_KEY=<staging-publishable-or-anon-key>
CWS_STAGING_B2_ENDPOINT=s3.<region>.backblazeb2.com
CWS_STAGING_B2_KEY_ID=<scoped-staging-application-key-id>
CWS_STAGING_B2_APP_KEY=<scoped-staging-application-key-secret>
CWS_STAGING_B2_BUCKET=<staging-bucket>
CWS_STAGING_B2_PREFIX=cws-staging/worker-e2e
CWS_STAGING_WORKER_ID=<stable-staging-node-identity>
CWS_STAGING_FLEET_ID=<positive-integer-fleet-id>
# Comma-separated HTTPS hostnames permitted for staging project downloads.
# Do not use a wildcard or an IP address unless that exact host is intentional.
CWS_STAGING_PROJECT_HOSTS=staging-files.example.com
