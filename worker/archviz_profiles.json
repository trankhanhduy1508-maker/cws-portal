      "safe_operational": ["missing_asset_diagnostics", "path_preflight", "device_backend_detection"],
      "benchmark_only": ["persistent_data_if_multiframe", "adaptive_sampling", "denoising", "bounce_tuning"],
      "do_not_auto_change": ["materials", "lights", "geometry", "texture_resolution", "camera", "output_resolution"]
