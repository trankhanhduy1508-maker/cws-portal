{
  "schema_version": "cws.archviz-profiles.v2",
  "principle": "workload profile helps routing; scene characteristics drive technical decisions",
  "profiles": {
    "ARCHVIZ_INTERIOR": {
      "observe": ["indirect_light", "glass_transmission", "transparent_alpha", "texture_pressure", "subdivision_displacement", "volume", "vram_risk"],
