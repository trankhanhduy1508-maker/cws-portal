      "benchmark_only": ["adaptive_sampling", "noise_threshold", "bounce_tuning", "denoising", "clamp", "caustics"],
      "do_not_auto_change": ["materials", "lights", "geometry", "texture_resolution", "camera", "output_resolution"]
    },
    "ARCHVIZ_EXTERIOR": {
      "observe": ["geometry_instances", "foliage_transparency", "texture_pressure", "displacement", "world_hdri", "vram_risk"],
      "safe_operational": ["missing_asset_diagnostics", "path_preflight", "device_backend_detection", "persistent_data_if_multiframe_and_memory_allows"],
      "benchmark_only": ["adaptive_sampling", "noise_threshold", "bounce_tuning", "denoising"],
      "do_not_auto_change": ["materials", "lights", "geometry", "foliage_density", "texture_resolution", "camera", "output_resolution"]
